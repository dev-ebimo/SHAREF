+export const check = (label, cond, extra = "") => { console.log(cond ? "OK  -" : "FAIL-", label, cond ? "" : extra); cond ? passed++ : failed++; };
+export const summary = () => { console.log(`\n${passed} passed, ${failed} failed`); process.exit(failed ? 1 : 0); };
