  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "hono": "^4.6.14",
    "mammoth": "^1.12.3",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
