{
  "name": "sharef-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute sharef-db --local --file=./src/db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute sharef-db --remote --file=./src/db/schema.sql"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "bcryptjs": "^3.0.3",
    "hono": "^4.6.14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "jszip": "^3.10.2",
    "wrangler": "^4.0.0"
  }
}
